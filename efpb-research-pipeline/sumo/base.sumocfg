<configuration>
  <input>
    <net-file value="net/intersection.net.xml" />
    <route-files value="routes/base.rou.xml" />
  </input>
  <time>
    <begin value="0" />
    <step-length value="1" />
  </time>
  <processing>
    <collision.action value="warn" />
    <time-to-teleport value="-1" />
  </processing>
  <report>
    <verbose value="false" />
    <duration-log.statistics value="true" />
  </report>
</configuration>
